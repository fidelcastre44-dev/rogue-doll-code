[ext_resource type="Script" path="res://combat/move_data.gd" id="1_xwerm"]

[resource]
script = ExtResource("1_xwerm")
id = &"grab"
display_name = "Chope"
notes = "3e élément d'une clé : \"lin\" = vitesse constante, \"in\" = part lentement et accélère (sinon : part vite et freine). Chope : passe la garde. Ratée, elle te laisse ouvert un moment. Réussie, elle enchaîne sur \"slam\"."
cancel = 0.5
end = 0.5
roll_ok = 0.3
step = 2.5
flags = PackedStringArray("grab")
keys = [[0.0, "from"], [0.1, "grab_reach"], [0.28, "grab_reach"], [0.5, "guard"]]
present = PackedStringArray("active", "cancel", "end", "roll", "grab", "lunge", "step", "keys")
